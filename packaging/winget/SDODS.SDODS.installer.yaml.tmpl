# Generated by scripts/sync-channels.ts — do not edit by hand. Every SHA-256 below is computed
# from the release asset that was actually downloaded, never transcribed.
PackageIdentifier: SDODS.SDODS
PackageVersion: {{VERSION}}
InstallerType: nullsoft
# electron-builder builds with perMachine: false, so the install lands in the user profile and
# needs no elevation. Declaring it wrong makes winget prompt for admin it never uses.
Scope: user
InstallModes:
  - interactive
  - silent
  - silentWithProgress
UpgradeBehavior: install
# Quoted: unquoted, YAML types this as a date, and the winget schema requires a string.
ReleaseDate: "{{RELEASE_DATE}}"
Installers:
  - Architecture: x64
    InstallerUrl: {{WIN_X64_URL}}
    InstallerSha256: {{WIN_X64_SHA256}}
  - Architecture: arm64
    InstallerUrl: {{WIN_ARM64_URL}}
    InstallerSha256: {{WIN_ARM64_SHA256}}
ManifestType: installer
ManifestVersion: 1.6.0
