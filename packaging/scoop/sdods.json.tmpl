{
  "##": [
    "Generated by scripts/sync-channels.ts — do not edit by hand. Lives in the public bucket repository siri1410/scoop-sdods as bucket/sdods.json, which makes the install `scoop bucket add sdods https://github.com/siri1410/scoop-sdods; scoop install sdods`.",
    "Scoop's schema sets additionalProperties:false and '##' is the only comment key it allows, so every note lives in this one array — a '##installer' key fails validation.",
    "electron-builder's NSIS takes /S for silent and /D for the target directory. /D must come last and must not be quoted — that is an NSIS rule, not a Scoop one, and quoting it silently installs to the default location instead."
  ],
  "version": "{{VERSION}}",
  "description": "BDD test automation for UI, API and hybrid flows",
  "homepage": "https://sdods.com",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "{{WIN_X64_URL}}#/setup.exe",
      "hash": "{{WIN_X64_SHA256}}"
    },
    "arm64": {
      "url": "{{WIN_ARM64_URL}}#/setup.exe",
      "hash": "{{WIN_ARM64_SHA256}}"
    }
  },
  "installer": {
    "script": [
      "$exe = \"$dir\\setup.exe\"",
      "Start-Process -Wait -FilePath $exe -ArgumentList '/S', \"/D=$dir\"",
      "Remove-Item $exe -Force"
    ]
  },
  "uninstaller": {
    "script": [
      "$un = \"$dir\\Uninstall SDODS.exe\"",
      "if (Test-Path $un) { Start-Process -Wait -FilePath $un -ArgumentList '/S' }"
    ]
  },
  "bin": "SDODS.exe",
  "shortcuts": [["SDODS.exe", "SDODS"]],
  "checkver": {
    "github": "https://github.com/siri1410/sdods-releases",
    "regex": "desktop-v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/siri1410/sdods-releases/releases/download/desktop-v$version/SDODS-Setup-$version-win-x64.exe#/setup.exe"
      },
      "arm64": {
        "url": "https://github.com/siri1410/sdods-releases/releases/download/desktop-v$version/SDODS-Setup-$version-win-arm64.exe#/setup.exe"
      }
    },
    "hash": {
      "url": "https://github.com/siri1410/sdods-releases/releases/download/desktop-v$version/SHA256SUMS.txt"
    }
  }
}
