rules_version = '2';

// Firestore for sdods.com. The sites are static exports, so browsers talk to Firestore directly and
// these rules are what stands between a stranger and the database.
//
// Questions and answers are written only by the community service (packages/community): browsers
// read what is published and nothing else. Feedback and page votes are still created from the
// browser, size-capped, and readable only by a moderator. Everything else is closed.

service cloud.firestore {
  match /databases/{database}/documents {

    // Google sign-in reports the account's primary address. sdods.com is a user alias domain for
    // yarlis.com, so the same mailbox signs in as admin@yarlis.com; admin@sdods.com stays for an
    // account that reports the alias.
    // Editors and admins also carry a `role` custom claim, set by the community service
    // (packages/community, POST /admin/role). A claim is part of the signed ID token, so reading it
    // costs no document lookup.
    function isModerator() {
      return request.auth != null
        && (
          (request.auth.token.email_verified == true
            && request.auth.token.email in ['admin@sdods.com', 'admin@yarlis.com'])
          || request.auth.token.role in ['editor', 'admin']
        );
    }

    // Questions, answers and replies. Every write goes through the community service
    // (packages/community), which signs posters in, reviews each post with the AI review agent and
    // keeps score and reputation consistent inside transactions. It writes with its service account,
    // which these rules do not apply to. Browsers only read what is published.
    //
    // Before the service existed, browsers created these as `pending` documents with a private
    // contact address beside them; those documents stay readable to moderators, and the editor queue
    // still lists any that are pending.
    //
    // `update` is closed even to moderators: a direct edit would bypass the score and reputation
    // bookkeeping. `delete` stays open to them, to remove something already published.

    match /questions/{questionId} {
      // `read` covers both get and list, so a pending question is invisible
      // to everyone but a moderator — it cannot even be enumerated.
      allow read: if resource.data.status == 'published' || isModerator();
      allow create, update: if false;
      allow delete: if isModerator();

      match /private/{contactId} {
        allow read, delete: if isModerator();
        allow create, update: if false;
      }

      match /answers/{answerId} {
        allow read: if resource.data.status == 'published' || isModerator();
        allow create, update: if false;
        allow delete: if isModerator();

        match /private/{contactId} {
          allow read, delete: if isModerator();
          allow create, update: if false;
        }
      }
    }

    // The editor queue lists pending answers across every live question at once, which is a
    // collection-group query and needs its own rule.
    match /{path=**}/answers/{answerId} {
      allow read: if isModerator();
    }

    // Answers and replies on the static archive threads (`/questions/<slug>/`).
    match /threadAnswers/{answerId} {
      allow read: if resource.data.status == 'published' || isModerator();
      allow create, update: if false;
      allow delete: if isModerator();

      match /private/{contactId} {
        allow read, delete: if isModerator();
        allow create, update: if false;
      }
    }

    // Feature requests and bug reports. Unlike questions these are never shown
    // on the site, so only the moderator can read them back. Name and email are
    // optional here — the form asks for them but does not insist.
    match /feedback/{feedbackId} {
      allow read: if isModerator();

      allow create: if request.resource.data.keys().hasOnly(
            ['kind', 'title', 'body', 'name', 'email', 'status', 'createdAt']
          )
        && request.resource.data.keys().hasAll(
            ['kind', 'title', 'body', 'name', 'email', 'status', 'createdAt']
          )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.kind in ['feature', 'bug', 'feedback']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;

      allow update, delete: if isModerator();
    }

    // "Was this page helpful?" on the docs site. One row per click, with an
    // optional note saying what was missing. Private, like feedback.
    match /pageFeedback/{voteId} {
      allow read: if isModerator();

      allow create: if request.resource.data.keys().hasOnly(
            ['path', 'title', 'verdict', 'note', 'status', 'createdAt']
          )
        && request.resource.data.keys().hasAll(
            ['path', 'title', 'verdict', 'note', 'status', 'createdAt']
          )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.verdict in ['helpful', 'not-helpful']
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 300
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000;

      allow update, delete: if isModerator();
    }

    // Maxi, the docs assistant: anonymous conversation logs and the daily spend counter. Only the
    // Maxi service writes them, with its service account, which security rules do not apply to.
    // Browsers get nothing; the moderator can read the logs to find gaps in the docs.
    match /maxiChats/{chatId} {
      allow read: if isModerator();
      allow write: if false;
    }
    match /maxiUsage/{day} {
      allow read, write: if false;
    }

    // The community service (packages/community) writes everything below with its service account.
    // Posts it creates land in the collections above, with the same fields plus `uid` and a `review`
    // summary, so the read rules above already cover them.
    //
    // Public profiles: a display name, reputation, badges and role. Never an email address.
    match /users/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Every reviewer verdict (model, signals, decision, token counts): the audit trail.
    match /communityReviews/{reviewId} {
      allow read: if isModerator();
      allow write: if false;
    }
    match /communityUsage/{day} {
      allow read, write: if false;
    }
    // Votes and the reputation history: written only by the service, inside transactions that also
    // move the post's score and the users' reputation. A user's own votes come back through the
    // service (GET /votes/mine), so browsers never read these directly.
    match /votes/{voteId} {
      allow read, write: if false;
    }
    // Revision history: every applied edit of a post is public, like Stack Overflow's. Suggested
    // edits (pending) and rejected ones are for moderators. Only the service writes.
    match /revisions/{revisionId} {
      allow read: if resource.data.status == 'applied' || isModerator();
      allow write: if false;
    }
    match /repEvents/{eventId} {
      allow read: if isModerator();
      allow write: if false;
    }

    // Nothing else in the database is reachable from a browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
