rules_version = '2';

// Q&A for sdods.com. The sites are static exports, so the browser talks to
// Firestore directly and these rules are the only thing standing between a
// stranger and the database. Two invariants carry the whole model:
//
//   1. Anyone may submit a question or answer, but only ever as 'pending'.
//      Nothing a stranger writes is readable by anyone else until a moderator
//      publishes it, so spam never reaches the page.
//   2. Only the moderator may publish, edit or delete anything.
//
// Every incoming field is size-capped: an unbounded public create is a free
// storage-fill endpoint.
service cloud.firestore {
  match /databases/{database}/documents {

    // Google sign-in reports the account's primary address. sdods.com is a user alias domain for
    // yarlis.com, so the same mailbox signs in as admin@yarlis.com; admin@sdods.com stays for an
    // account that reports the alias.
    // Editors and admins also carry a `role` custom claim, set by the community service
    // (packages/community, POST /admin/role). A claim is part of the signed ID token, so reading it
    // costs no document lookup.
    function isModerator() {
      return request.auth != null
        && (
          (request.auth.token.email_verified == true
            && request.auth.token.email in ['admin@sdods.com', 'admin@yarlis.com'])
          || request.auth.token.role in ['editor', 'admin']
        );
    }

    // Fields every public post shares. `createdAt` must be the server's clock, not a timestamp the
    // client chose. There is no email here: a published post is readable by anyone with the SDK,
    // so the address lives in a private `private/contact` document beside it (see validContact).
    function validPost(d) {
      return d.status == 'pending'
        && d.createdAt == request.time
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.body is string && d.body.size() > 0 && d.body.size() <= 5000;
    }

    // An answer or a reply. `parentId` is optional on live answers and required on thread answers;
    // empty means an answer to the question, anything else names the answer being replied to.
    function validParent(d) {
      return !('parentId' in d)
        || (d.parentId is string && d.parentId.size() <= 64);
    }

    // The contact document for a post, written in the same batch as the post itself: the post must
    // exist once the batch lands and carry this write's timestamp, so an address can never be
    // attached to somebody else's post after the fact. Only the moderator reads it back.
    function validContact(postPath) {
      return request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('.+@.+[.].+')
        && existsAfter(postPath)
        && getAfter(postPath).data.createdAt == request.time;
    }

    match /questions/{questionId} {
      // `read` covers both get and list, so a pending question is invisible
      // to everyone but the moderator — it cannot even be enumerated.
      allow read: if resource.data.status == 'published' || isModerator();

      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'title', 'body', 'category', 'status', 'createdAt']
          )
        && request.resource.data.keys().hasAll(
            ['name', 'title', 'body', 'category', 'status', 'createdAt']
          )
        && validPost(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.category in ['ui', 'api', 'hybrid', 'other'];

      allow update, delete: if isModerator();

      match /private/{contactId} {
        allow read, update, delete: if isModerator();
        allow create: if contactId == 'contact'
          && validContact(/databases/$(database)/documents/questions/$(questionId));
      }

      // Answers hang off a question. A stranger may answer, but the answer is
      // pending too, so an unmoderated reply is invisible even on a published
      // question.
      match /answers/{answerId} {
        allow read: if resource.data.status == 'published' || isModerator();

        allow create: if request.resource.data.keys().hasOnly(
              ['name', 'body', 'parentId', 'status', 'createdAt']
            )
          && request.resource.data.keys().hasAll(
              ['name', 'body', 'status', 'createdAt']
            )
          && validPost(request.resource.data)
          && validParent(request.resource.data)
          // Only answer a question that exists and is already public.
          && get(/databases/$(database)/documents/questions/$(questionId))
               .data.status == 'published';

        allow update, delete: if isModerator();

        match /private/{contactId} {
          allow read, update, delete: if isModerator();
          allow create: if contactId == 'contact'
            && validContact(
                 /databases/$(database)/documents/questions/$(questionId)/answers/$(answerId)
               );
        }
      }
    }

    // The moderation page lists pending answers across every live question at once, which is a
    // collection-group query and needs its own rule.
    match /{path=**}/answers/{answerId} {
      allow read: if isModerator();
    }

    // Answers and replies on the static archive threads (`/questions/<slug>/`). Those threads are
    // not documents, so there is no parent to check: the slug is only held to the shape a slug has,
    // and a post naming a thread that does not exist is simply never shown. Pending until published,
    // like everything else here.
    match /threadAnswers/{answerId} {
      allow read: if resource.data.status == 'published' || isModerator();

      allow create: if request.resource.data.keys().hasOnly(
            ['slug', 'parentId', 'name', 'body', 'status', 'createdAt']
          )
        && request.resource.data.keys().hasAll(
            ['slug', 'parentId', 'name', 'body', 'status', 'createdAt']
          )
        && request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9-]{1,120}$')
        && validPost(request.resource.data)
        && validParent(request.resource.data);

      allow update, delete: if isModerator();

      match /private/{contactId} {
        allow read, update, delete: if isModerator();
        allow create: if contactId == 'contact'
          && validContact(/databases/$(database)/documents/threadAnswers/$(answerId));
      }
    }

    // Feature requests and bug reports. Unlike questions these are never shown
    // on the site, so only the moderator can read them back. Name and email are
    // optional here — the form asks for them but does not insist.
    match /feedback/{feedbackId} {
      allow read: if isModerator();

      allow create: if request.resource.data.keys().hasOnly(
            ['kind', 'title', 'body', 'name', 'email', 'status', 'createdAt']
          )
        && request.resource.data.keys().hasAll(
            ['kind', 'title', 'body', 'name', 'email', 'status', 'createdAt']
          )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.kind in ['feature', 'bug', 'feedback']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 5000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;

      allow update, delete: if isModerator();
    }

    // "Was this page helpful?" on the docs site. One row per click, with an
    // optional note saying what was missing. Private, like feedback.
    match /pageFeedback/{voteId} {
      allow read: if isModerator();

      allow create: if request.resource.data.keys().hasOnly(
            ['path', 'title', 'verdict', 'note', 'status', 'createdAt']
          )
        && request.resource.data.keys().hasAll(
            ['path', 'title', 'verdict', 'note', 'status', 'createdAt']
          )
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.verdict in ['helpful', 'not-helpful']
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 300
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000;

      allow update, delete: if isModerator();
    }

    // Maxi, the docs assistant: anonymous conversation logs and the daily spend counter. Only the
    // Maxi service writes them, with its service account, which security rules do not apply to.
    // Browsers get nothing; the moderator can read the logs to find gaps in the docs.
    match /maxiChats/{chatId} {
      allow read: if isModerator();
      allow write: if false;
    }
    match /maxiUsage/{day} {
      allow read, write: if false;
    }

    // The community service (packages/community) writes everything below with its service account.
    // Posts it creates land in the collections above, with the same fields plus `uid` and a `review`
    // summary, so the read rules above already cover them.
    //
    // Public profiles: a display name, reputation, badges and role. Never an email address.
    match /users/{uid} {
      allow read: if true;
      allow write: if false;
    }
    // Every reviewer verdict (model, signals, decision, token counts): the audit trail.
    match /communityReviews/{reviewId} {
      allow read: if isModerator();
      allow write: if false;
    }
    match /communityUsage/{day} {
      allow read, write: if false;
    }

    // Nothing else in the database is reachable from a browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
