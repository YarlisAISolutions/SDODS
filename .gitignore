apps/docs/public/install.ps1*
apps/www/public/install.sh*
apps/www/public/install.ps1*

# Publish-time staging: generated by scripts/build-publish-assets.ts before packing
packages/cli/templates/
packages/server/web/
.publish-stage/

# Python virtualenvs (media/film/tts tooling)
.venv/

# Brand previews and verification shots: regenerated by brand/preview.ts and brand/verify.ts
brand/candidates/preview/
brand/verify/
