{
  "mcpServers": {
    "sdods": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "sdods",
        "mcp",
        "--project",
        "demo-shop",
        "--env",
        "staging"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "playwright",
        "mcp",
        "--headless"
      ],
      "env": {}
    }
  }
}