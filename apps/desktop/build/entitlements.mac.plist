<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      The app spawns a bundled Node binary, which then loads .node native modules that npm
      downloaded at runtime (better-sqlite3, argon2). Under the hardened runtime those are
      unsigned code from Gatekeeper's point of view, so without this the app notarizes fine and
      then dies at first database open with an opaque dyld error.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- V8 in the child Node process. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The child inherits PATH, SDODS_ROOT, PLAYWRIGHT_BROWSERS_PATH and friends. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Test runs reach staging sites and the npm registry. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
  </dict>
</plist>
