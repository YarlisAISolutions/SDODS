{
  "name": "@sdods/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "SDODS desktop app \u2014 installs, launches and upgrades SDODS in one click",
  "main": "./out/main/index.js",
  "homepage": "https://sdods.com",
  "author": {
    "name": "SDODS",
    "email": "admin@sdods.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "probe": "node --import tsx scripts/probe.ts",
    "fetch:node": "node --import tsx scripts/fetch-node-runtime.ts",
    "pack": "electron-vite build && electron-builder --dir",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6"
  }
}
