{
  "name": "@sdods/docs",
  "version": "0.1.0",
  "private": true,
  "description": "SDODS documentation site (Fumadocs on Next.js, static export on Firebase Hosting).",
  "license": "Apache-2.0",
  "author": "SDODS <admin@sdods.com>",
  "scripts": {
    "dev": "next dev",
    "build": "node --import tsx ../../scripts/sync-installer.ts && node --import tsx scripts/collect-screenshots.ts && next build && node --import tsx scripts/check-links.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "node --import tsx scripts/verify-examples.ts",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@sdods/roadmap": "workspace:*",
    "firebase": "^12.18.0",
    "fumadocs-core": "^16.15.5",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.5",
    "mermaid": "^11.17.2",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cheerio": "^1.2.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
