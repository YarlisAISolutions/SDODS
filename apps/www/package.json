{
  "name": "@sdods/www",
  "version": "0.1.0",
  "private": true,
  "description": "SDODS landing site (sdods.com / www.sdods.com): Next.js static export on Firebase Hosting.",
  "license": "Apache-2.0",
  "author": "SDODS <admin@sdods.com>",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "node --import tsx ../../scripts/sync-installer.ts && node --import tsx ../../scripts/sync-brand.ts && node --import tsx ../../scripts/build-qa-index.ts && next build",
    "typecheck": "tsc --noEmit",
    "screenshots": "node --import tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@sdods/contracts": "workspace:*",
    "@sdods/qa-archive": "workspace:*",
    "@sdods/roadmap": "workspace:*",
    "@sdods/site-kit": "workspace:*",
    "firebase": "^12.19.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
