{
  "name": "@sdods/db",
  "version": "0.1.0",
  "description": "SDODS platform database: Kysely schema for SQLite and Postgres, migrations, cucumber NDJSON ingest, driver switch, insights.",
  "license": "Apache-2.0",
  "author": "Sireesh Yarlagadda (https://www.linkedin.com/in/yarlagadda/)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./ingest": "./src/ingest/index.ts",
    "./switch": "./src/switch/index.ts",
    "./insights": "./src/insights.ts",
    "./test-data": "./src/test-data.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./schema": "./dist/schema.js",
      "./ingest": "./dist/ingest/index.js",
      "./switch": "./dist/switch/index.js",
      "./insights": "./dist/insights.js",
