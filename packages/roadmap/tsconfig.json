{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Consumed as raw TypeScript by two Next apps, whose bundler resolves extension-less
    // specifiers; NodeNext's mandatory `.js` suffixes are what Turbopack cannot follow here.
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["src"]
}
