  },
  "dependencies": {
    "@sdods/contracts": "workspace:*",
    "@sdods/core": "workspace:*",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "^4.5.4",
    "@playwright/test": "^1.62.1",
    "playwright-core": "^1.62.1",
    "@sdods/integrations": "workspace:*",
    "@sdods/mcp": "workspace:*",
    "@sdods/agents": "workspace:*",
    "@sdods/db": "workspace:*",
    "csv-parse": "^7.0.2",
    "@sdods/server": "workspace:*"
  },
  "devDependencies": {
    "@types/semver": "^7.7.0"
  }
}
