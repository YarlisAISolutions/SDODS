{
  "name": "@sdods/cli",
  "version": "0.1.0",
  "description": "sdods — the command-line entry point for SDODS: init, analyze, run, lint, record, har, data, db, report, agent, mcp, serve, schedule, integrations.",
  "license": "Apache-2.0",
  "author": "Sireesh Yarlagadda (https://www.linkedin.com/in/yarlagadda/)",
  "type": "module",
  "bin": {
    "sdods": "./bin/sdods.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "templates"
  ],
  "engines": {
