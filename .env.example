# ── AutoMax platform ────────────────────────────────────────────────────────
# Database toggle: sqlite (default, zero setup) or postgres
DB_DRIVER=sqlite
SQLITE_PATH=.automax/automax.db
# DATABASE_URL=postgres://automax:automax@localhost:5432/automax

# Web server
PORT=4444
HOST=127.0.0.1
SESSION_SECRET=change-me-32-chars-minimum-please
# AUTOMAX_PUBLIC_URL=https://automax.example.com
# AUTH_DISABLED=1   # local dev only

# Where projects and run artifacts live (defaults shown)
# AUTOMAX_PROJECTS_DIR=projects
# AUTOMAX_ARTIFACTS_DIR=.automax/runs

# ── Agents (optional; every agent feature has --dry-run and a fake adapter) ─
# AUTOMAX_LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# ── Integrations (names only are stored in project yaml; values live here) ──
# GITHUB_TOKEN=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
