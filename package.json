{
  "name": "automax-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AutoMax — an automation platform: BDD UI + API + hybrid testing, multi-project, data-driven, self-healing, MCP, agents.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "automax": "node --import tsx ./packages/cli/src/bin.ts",
    "typecheck": "tsc -b && bun run --filter @automax/web typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:pg": "DB_DRIVER=postgres vitest run packages/db --no-file-parallelism",
    "demo:api": "node --import tsx ./packages/cli/src/bin.ts run -p demo-shop -e staging -l api",
    "demo:ui": "node --import tsx ./packages/cli/src/bin.ts run -p demo-shop -e staging -l ui -b chromium -t @smoke",
    "release:check": "node --import tsx ./packages/cli/src/bin.ts run -p demo-shop -e staging --project-matrix -t @smoke --har-replay --strict",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:verify": "bun run --cwd apps/docs verify",
    "web:dev": "bun run --filter @automax/web dev:mocks",
    "web:build": "bun run --filter @automax/web build",
    "release:check:live": "node --import tsx ./packages/cli/src/bin.ts run -p demo-shop -e staging --project-matrix -t \"@smoke or @sanity or @regression\"",
    "dogfood": "bash scripts/dogfood.sh"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-playwright": "^2.11.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "playwright-bdd": "^9.2.0",
    "@automax/contracts": "workspace:*",
    "@automax/core": "workspace:*",
    "@automax/cli": "workspace:*",
    "@changesets/cli": "^3.0.1",
    "execa": "^10.0.1"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "argon2",
    "@playwright/test",
    "playwright",
    "esbuild"
  ]
}
