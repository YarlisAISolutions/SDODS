{
  "name": "sdods-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SDODS \u2014 an automation platform: BDD UI + API + hybrid testing, multi-project, data-driven, self-healing, MCP, agents.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "sdods": "node --import tsx ./packages/cli/src/bin.ts",
    "typecheck": "tsc -b && bun run --filter @sdods/web typecheck && bun run --filter @sdods/desktop typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:pg": "DB_DRIVER=postgres vitest run packages/db --no-file-parallelism",
    "demo:api": "node --import tsx ./packages/cli/src/bin.ts run -p demo-shop -e staging -l api",
    "demo:ui": "node --import tsx ./packages/cli/src/bin.ts run -p demo-shop -e staging -l ui -b chromium -t @smoke",
    "release:check": "node --import tsx ./packages/cli/src/bin.ts run -p demo-shop -e staging -b chromium -b firefox -b webkit -t @smoke --har-replay --strict",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:verify": "bun run --cwd apps/docs verify",
    "web:dev": "bun run --filter @sdods/web dev:mocks",
    "web:build": "bun run --filter @sdods/web build",
    "release:check:live": "node --import tsx ./packages/cli/src/bin.ts run -p demo-shop -e staging -b chromium -b firefox -b webkit -t \"@smoke or @sanity or @regression\"",
    "release:check:edge": "node --import tsx ./packages/cli/src/bin.ts run -p demo-shop -e staging -l ui -b edge -t @smoke",
    "dogfood": "bash scripts/dogfood.sh",
    "www:dev": "bun run --cwd apps/www dev",
    "www:build": "bun run --cwd apps/www build",
    "www:screenshots": "bun run --cwd apps/www screenshots",
    "api:build": "gcloud builds submit --project automax-docs --region us-central1 --tag us-central1-docker.pkg.dev/automax-docs/sdods/automax-api:latest .",
    "api:deploy": "bash deploy/deploy-cloud-run.sh",
    "api:deploy-hosting": "firebase deploy --only hosting:api --project automax-docs",
    "api:bootstrap": "bash deploy/bootstrap-admin.sh",
    "publish:assets": "node --import tsx ./scripts/build-publish-assets.ts",
    "publish:stage": "node --import tsx ./scripts/stage-npm-packages.ts",
    "installer:sync": "node --import tsx ./scripts/sync-installer.ts",
    "roadmap:sync": "node --import tsx ./scripts/sync-roadmap.ts",
    "desktop:sync-release": "node --import tsx ./scripts/sync-desktop-release.ts",
    "desktop:dev": "bun run --filter @sdods/desktop dev",
    "desktop:dist": "bun run --filter @sdods/desktop build && bun run --cwd apps/desktop dist:mac",
    "brand:sync": "node --import tsx ./scripts/sync-brand.ts",
    "channels:sync": "node --import tsx ./scripts/sync-channels.ts",
    "qa:index": "node --import tsx ./scripts/build-qa-index.ts",
    "mcp:count-sync": "node --import tsx ./scripts/sync-mcp-tool-count.ts",
    "mcp:browser-fixture": "node --import tsx ./scripts/gen-browser-fixture.ts",
    "mcp:browser-shapes": "node --import tsx ./scripts/gen-browser-shapes.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@sdods/cli": "workspace:*",
    "@sdods/contracts": "workspace:*",
    "@sdods/core": "workspace:*",
    "@sdods/mcp": "workspace:*",
    "@sdods/qa-archive": "workspace:*",
    "@sdods/roadmap": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-playwright": "^2.11.0",
    "execa": "^10.0.1",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "argon2",
    "@playwright/test",
    "playwright",
    "esbuild",
    "electron",
    "electron-builder",
    "app-builder-bin",
    "7zip-bin",
    "dmg-license"
  ]
}
